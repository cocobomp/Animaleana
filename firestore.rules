rules_version = '2';

// Règles de la base des sauvegardes (Firestore, région europe-west6 = Zurich).
// Chaque compte Google ne peut lire et écrire QUE ses propres parties :
//   users/{uid}/saves/{profileId}  (une partie = un document)
// Tout le reste est fermé. Mise en ligne : npx firebase-tools deploy --only firestore:rules
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // Une partie : le profil en texte JSON (data), sa date de modification (ms) et quelques
    // informations pour la liste (prénom, version). Taille limitée (un document fait 1 Mo au plus).
    function validSave() {
      let d = request.resource.data;
      return d.keys().hasOnly(['data', 'updatedAt', 'name', 'saveVersion', 'appVersion', 'deleted'])
        && d.data is string && d.data.size() <= 900000
        && d.updatedAt is int
        && (!('name' in d) || (d.name is string && d.name.size() <= 60))
        && (!('saveVersion' in d) || d.saveVersion is int)
        && (!('appVersion' in d) || (d.appVersion is string && d.appVersion.size() <= 40))
        && (!('deleted' in d) || d.deleted is bool);
    }

    match /users/{uid}/saves/{profileId} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid) && profileId.size() <= 64 && validSave();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
