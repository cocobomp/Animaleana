rules_version = '2';

// Règles de la base des sauvegardes (Firestore, région europe-west6 = Zurich).
// Chaque compte Google ne peut lire et écrire QUE ses propres parties :
//   users/{uid}/saves/{profileId}  (une partie = un document)
// 💌 Les avis des joueurs : feedback/{id}, écrits sans compte, jamais relus depuis le jeu.
// Tout le reste est fermé. Mise en ligne : npx firebase-tools deploy --only firestore:rules --project lafermeamadichelle
// Tests : tests/firestoreRules.test.js (avec l'émulateur, voir docs/HEBERGEMENT.md).
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // Une partie : le profil en texte JSON (data), sa date de modification (ms, pour information), son numéro
    // de version (rev : 1 à la création, +1 à chaque écriture), son identité (gen : tirée au hasard à la création,
    // jamais changée ensuite ; une partie effacée puis remise dans le compte a un autre gen) et quelques
    // informations pour la liste (prénom, version). Taille limitée (un document fait 1 Mo au plus).
    // Pierre tombale : data vide, gone (pas « deleted » : les appareils restés en v1 effaçaient sans regarder).
    function validSave() {
      let d = request.resource.data;
      return d.keys().hasAll(['data', 'updatedAt', 'rev', 'gen'])
        && d.keys().hasOnly(['data', 'updatedAt', 'rev', 'gen', 'name', 'saveVersion', 'appVersion', 'gone'])
        && d.data is string && d.data.size() <= 900000
        && d.updatedAt is int
        && d.rev is int && d.rev >= 1
        && d.gen is string && d.gen.size() >= 1 && d.gen.size() <= 40
        && (!('name' in d) || (d.name is string && d.name.size() <= 60))
        && (!('saveVersion' in d) || d.saveVersion is int)
        && (!('appVersion' in d) || (d.appVersion is string && d.appVersion.size() <= 40))
        && (!('gone' in d) || d.gone is bool);
    }

    // Identifiant d'une partie : lettres, chiffres, - et _ (64 au plus).
    function validId(profileId) {
      return profileId.matches('^[A-Za-z0-9_-]{1,64}$');
    }

    match /users/{uid}/saves/{profileId} {
      allow read: if isOwner(uid);
      // « Effacer mes parties en ligne » / « Supprimer mon compte ».
      allow delete: if isOwner(uid);
      // Création : rev 1. Mise à jour : exactement la rev suivante (une écriture faite à partir d'une version
      // déjà dépassée est refusée : aucune partie n'est écrasée en silence), et le même gen. Les documents d'avant
      // les rev (première version de la synchro) comptent comme rev 0 et reçoivent leur gen à la mise à jour.
      allow create: if isOwner(uid) && validId(profileId) && validSave()
        && request.resource.data.rev == 1;
      allow update: if isOwner(uid) && validId(profileId) && validSave()
        && request.resource.data.rev == resource.data.get('rev', 0) + 1
        && (!('gen' in resource.data) || request.resource.data.gen == resource.data.gen);
    }

    // 💌 Un avis de joueur (src/cloud/feedback.js) : exactement les champs prévus, rien de personnel (ni prénom, ni
    // partie, ni compte, ni e-mail). Un texte court (500 caractères au plus), une humeur et une sorte (dans leurs
    // listes), et de quoi le comprendre : langue, version du jeu, appareil, sens de l'écran, mode, niveau, jour du jeu,
    // lieu, ce qui était ouvert. createdAt : l'heure du serveur (serverTimestamp), jamais celle de l'appareil.
    function validFeedback() {
      let d = request.resource.data;
      let fields = ['text', 'mood', 'kind', 'lang', 'version', 'device', 'orientation', 'mode', 'level', 'day', 'place', 'screen', 'createdAt'];
      return d.keys().hasAll(fields) && d.keys().hasOnly(fields)
        && d.text is string && d.text.size() <= 500
        && d.mood in ['love', 'happy', 'meh', 'sad', 'none']
        && (d.text.size() > 0 || d.mood != 'none')
        && d.kind in ['idea', 'bug', 'like', 'other']
        && d.lang in ['fr', 'en']
        && d.version is string && d.version.size() >= 1 && d.version.size() <= 40
        && d.device in ['phone', 'tablet', 'computer']
        && d.orientation in ['portrait', 'landscape']
        && d.mode in ['sandbox', 'manage', 'none']
        && d.level is int && d.level >= 0 && d.level <= 1000
        && d.day is int && d.day >= 0 && d.day <= 1000000
        && d.place is string && d.place.size() <= 30
        && d.screen is string && d.screen.size() <= 40
        && d.createdAt == request.time;
    }

    // N'importe qui peut en écrire un (avec ou sans compte : le jeu l'envoie sans). Personne ne peut les lire, les
    // modifier ni les effacer depuis le jeu : le développeur les lit dans la console Firebase.
    match /feedback/{id} {
      allow create: if validFeedback();
      allow read, update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
