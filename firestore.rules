rules_version = '2';

// Règles de la base des sauvegardes (Firestore, région europe-west6 = Zurich).
// Chaque compte Google ne peut lire et écrire QUE ses propres parties :
//   users/{uid}/saves/{profileId}  (une partie = un document)
// Tout le reste est fermé. Mise en ligne : npx firebase-tools deploy --only firestore:rules
// Tests : tests/firestoreRules.test.js (avec l'émulateur, voir docs/HEBERGEMENT.md).
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // Une partie : le profil en texte JSON (data), sa date de modification (ms, pour information), son numéro
    // de version (rev : 1 à la création, +1 à chaque écriture) et quelques informations pour la liste
    // (prénom, version). Taille limitée (un document fait 1 Mo au plus). Pierre tombale : data vide, deleted.
    function validSave() {
      let d = request.resource.data;
      return d.keys().hasAll(['data', 'updatedAt', 'rev'])
        && d.keys().hasOnly(['data', 'updatedAt', 'rev', 'name', 'saveVersion', 'appVersion', 'deleted'])
        && d.data is string && d.data.size() <= 900000
        && d.updatedAt is int
        && d.rev is int && d.rev >= 1
        && (!('name' in d) || (d.name is string && d.name.size() <= 60))
        && (!('saveVersion' in d) || d.saveVersion is int)
        && (!('appVersion' in d) || (d.appVersion is string && d.appVersion.size() <= 40))
        && (!('deleted' in d) || d.deleted is bool);
    }

    // Identifiant d'une partie : lettres, chiffres, - et _ (64 au plus).
    function validId(profileId) {
      return profileId.matches('^[A-Za-z0-9_-]{1,64}$');
    }

    match /users/{uid}/saves/{profileId} {
      allow read: if isOwner(uid);
      // « Effacer mes parties en ligne » / « Supprimer mon compte ».
      allow delete: if isOwner(uid);
      // Création : rev 1. Mise à jour : exactement la rev suivante (une écriture faite à partir d'une version
      // déjà dépassée est refusée : aucune partie n'est écrasée en silence). Les documents d'avant les rev
      // (première version de la synchro) comptent comme rev 0.
      allow create: if isOwner(uid) && validId(profileId) && validSave()
        && request.resource.data.rev == 1;
      allow update: if isOwner(uid) && validId(profileId) && validSave()
        && request.resource.data.rev == resource.data.get('rev', 0) + 1;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
